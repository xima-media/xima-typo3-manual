{
	"name": "xima/xima-typo3-manual",
	"description": "TYPO3 extension to create editor manuals right in the TYPO3 backend.",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"typo3-cms-extension",
		"manual",
		"documentation",
		"editor"
	],
	"authors": [
		{
			"name": "Maik Schneider",
			"email": "maik.schneider@xima.de",
			"role": "Developer"
		}
	],
	"homepage": "https://www.xima.de",
	"support": {
		"issues": "https://github.com/xima-media/xima-typo3-manual/issues",
		"source": "https://github.com/xima-media/xima-typo3-manual"
	},
	"require": {
		"php": "^8.2",
		"ext-dom": "*",
		"ext-fileinfo": "*",
		"ext-simplexml": "*",
		"blueways/bw-focuspoint-images": "^6.0 || ^7.0",
		"blueways/bw-icons": "^4.0 || ^5.0",
		"dompdf/dompdf": "^2.0 || ^3.0",
		"typo3/cms-core": "^13.4.29 || ^14.3",
		"typo3/cms-filelist": "^13.4 || ^14.3",
		"typo3/cms-fluid-styled-content": "^13.4 || ^14.3",
		"typo3/cms-indexed-search": "^13.4 || ^14.3",
		"typo3/cms-rte-ckeditor": "^13.4 || ^14.3"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.0",
		"bk2k/bootstrap-package": "^15.0 || ^16.0",
		"ergebnis/composer-normalize": "^2.54",
		"friendsofphp/php-cs-fixer": "^3.57",
		"friendsoftypo3/visual-editor": "^1.10",
		"helhum/typo3-console": "^8.2 || ^9.0",
		"helmich/typo3-typoscript-lint": "^3.3",
		"move-elevator/composer-translation-validator": "^1.4",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan": "^2.0",
		"rector/rector": "<2.9 || 2.9.2",
		"saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
		"ssch/typo3-rector": "^3.3",
		"typo3/cms-lowlevel": "^13.4 || ^14.3",
		"typo3/testing-framework": "^9.0"
	},
	"suggest": {
		"friendsoftypo3/visual-editor": "Inline WYSIWYG editing of manual chapters in the TYPO3 backend (TYPO3 v13.4.22+ and v14)"
	},
	"autoload": {
		"psr-4": {
			"Xima\\XimaTypo3Manual\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Xima\\XimaTypo3Manual\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"move-elevator/composer-translation-validator": true,
			"phpstan/extension-installer": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"lock": false,
		"sort-packages": true,
		"vendor-dir": "vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"extension-key": "xima_typo3_manual",
			"version": "3.0.0",
			"web-dir": "public"
		}
	},
	"scripts": {
		"ci:composer:normalize": "@composer normalize --no-check-lock --dry-run",
		"ci:editorconfig:lint": "ec --strict --git-only -n",
		"ci:language:lint": "@composer validate-translations Resources/Private/Language",
		"ci:php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix --dry-run --format=checkstyle > php-cs-fixer.xml",
		"ci:php:lint": "find *.php . -name '*.php' ! -path './vendor/*' ! -path './var/*' ! -path '*node_modules/*' ! -path './public/*' -print0 | xargs -0 -n 1 -P 4 php -l",
		"ci:php:rector": "rector --dry-run",
		"ci:php:stan": "phpstan --no-progress --error-format=checkstyle > phpstan.xml",
		"ci:sca": [
			"@ci:composer:normalize",
			"@ci:editorconfig:lint",
			"@ci:php:lint",
			"@ci:php:rector",
			"@ci:php:fixer",
			"@ci:php:stan",
			"@ci:language:lint",
			"@ci:typoscript:lint",
			"@ci:yaml:lint"
		],
		"ci:typoscript:lint": "typoscript-lint --fail-on-warnings",
		"ci:yaml:lint": "find ./ ! -path '*node_modules/*' ! -path './vendor/*' ! -path './public/*' \\( -name '*.yaml' -o -name '*.yml' \\) | xargs -r yaml-lint --parse-tags",
		"composer:normalize": "@composer normalize --no-check-lock",
		"editorconfig:lint": "ec --strict --fix --git-only -n",
		"language:lint": "@composer validate-translations Resources/Private/Language",
		"php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix",
		"php:lint": "find *.php . -name '*.php' ! -path './vendor/*' ! -path './var/*' ! -path '*node_modules/*' ! -path './public/*' -print0 | xargs -0 -n 1 -P 4 php -l",
		"php:rector": "rector",
		"php:stan": "phpstan --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
		"sca": [
			"@composer:normalize",
			"@editorconfig:lint",
			"@php:lint",
			"@php:rector",
			"@php:fixer",
			"@php:stan",
			"@language:lint",
			"@typoscript:lint",
			"@yaml:lint"
		],
		"test": [
			"@test:unit",
			"@test:functional"
		],
		"test:coverage": [
			"@test:coverage:unit",
			"@test:coverage:functional"
		],
		"test:coverage:functional": "phpunit -c phpunit.functional.xml --coverage-clover coverage/clover-functional.xml",
		"test:coverage:unit": "phpunit -c phpunit.unit.xml --coverage-clover coverage/clover-unit.xml",
		"test:functional": "phpunit -c phpunit.functional.xml",
		"test:unit": "phpunit -c phpunit.unit.xml",
		"typoscript:lint": "typoscript-lint",
		"yaml:lint": "find ./ ! -path '*node_modules/*' ! -path './vendor/*' ! -path './public/*' \\( -name '*.yaml' -o -name '*.yml' \\) | xargs -r yaml-lint --parse-tags"
	}
}
