# Remove the exclusion of the bw_focuspoint_images_svg content element from the new content element wizard
mod.wizards.newContentElement.wizardItems {
  default.removeItems := removeFromList(mannotation,mbox,msteps,mtext)
}

# Hide the content element groups of other extensions on manual pages
mod.wizards.newContentElement.wizardItems {
  common.show =
  forms.show =
  special.show =
  plugins.show =
  menu.show =
  luxletter.show =
  container.show =
  ext-news.show =
}

TCEFORM.tt_content {
  CType.keepItems = mtext,mbox,msteps,mannotation
  assets.config.maxitems = 1
  imageorient.disabled = 0
  imageorient.keepItems = 0,8,25,26
  colPos.addItems.1 = Content Slider
  header_layout.disabled = 1
  header_position.disabled = 1
  date.disabled = 1
  header_link.disabled = 1
  subheader.disabled = 1
  tx_bwicons_icon.disabled = 1
  layout >
}

mod.tx_bwfocuspointimages.settings.fields {

  type {
    title = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.type
    type = select
    options {
      default = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.default
      marking = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.marking
    }
    default = default
  }

  markerPosition {
    title = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.markerPosition
    type = select
    displayCond = FIELD:type:=:marking
    options {
      left = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.markerPosition.left
      right = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.markerPosition.right
      top = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.markerPosition.top
      bottom = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.markerPosition.bottom
      inside = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.markerPosition.inside
    }
    default = left
  }

  title {
    title = LLL:EXT:xima_typo3_manual/Resources/Private/Language/locallang.xlf:focus_point.title
    type = text
  }

  description {
    title = LLL:EXT:bw_focuspoint_images/Resources/Private/Language/locallang_db.xlf:wizard.fields.description
    type = textarea
  }

}

mod.tx_bwicons {
  typo3icons = Blueways\BwIcons\Provider\FileIconProvider
  typo3icons {
    title = TYPO3 Icons
    folder = EXT:core/Resources/Public/Icons/T3Icons/svgs
  }
}

RTE {
  default {
    preset = xima_typo3_manual
  }
}

mod.web_layout.BackendLayouts {
  manualHomepage {
    title = Manual Homepage
    config {
      backend_layout {
        colCount = 0
        rowCount = 0
      }
    }
  }
}
