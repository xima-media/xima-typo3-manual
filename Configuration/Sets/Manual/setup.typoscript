@import 'EXT:bw_focuspoint_images/Configuration/TypoScript/setup.typoscript'

page = PAGE
page {
  10 = FLUIDTEMPLATE
  10 {
    templateName = Default
    layoutRootPaths.10 = EXT:xima_typo3_manual/Resources/Private/Layouts
    partialRootPaths.10 = EXT:xima_typo3_manual/Resources/Private/Partials
    templateRootPaths.10 = EXT:xima_typo3_manual/Resources/Private/Templates

    variables {
      context = TEXT
      context.value = frontend
      context.override.data = GP:context
      title = TEXT
      title.data = leveltitle:0
      eyebrow = TEXT
      eyebrow.value = {$manual.appearance.eyebrow}
      lead = TEXT
      lead.data = levelfield:0, subtitle
      currentPageUid = TEXT
      currentPageUid.data = page:uid
      rootPageUid = TEXT
      rootPageUid.data = levelUid:0
      faqPageUid = TEXT
      faqPageUid.value = {$manual.navigation.faqPage}
      changelogPageUid = TEXT
      changelogPageUid.value = {$manual.navigation.changelogPage}
      displayFullManual = TEXT
      displayFullManual.value = {$manual.behaviour.displayFullManual}
      showNavigation = TEXT
      showNavigation.value = {$manual.appearance.showNavigation}
      showToc = TEXT
      showToc.value = {$manual.appearance.showToc}
      showContentInNavigation = TEXT
      showContentInNavigation.value = {$manual.appearance.showContentInNavigation}
      searchWord = TEXT
      searchWord.data = GP:tx_indexedsearch_manualresults|search|sword
    }

    dataProcessing {
      # Main navigation
      10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
      10 {
        as = pages
        levels = 9
        entryLevel = 0
        expandAll = 1
        includeNotInMenu = 1

        dataProcessing {
          10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
          10 {
            as = chapters
            table = tt_content
            pidInList.field = uid
            where = header!="" and colPos=0
          }

          # Turns the page row of a menu item into a Record, which f:render.text needs to make the chapter title editable
          20 = record-transformation
          20 {
            table = pages
            as = record
          }
        }
      }

      # Previous and next page in reading order, built from the main navigation
      15 = Xima\XimaTypo3Manual\DataProcessing\PageNavigationProcessor

      # Manual settings and backend appearance
      20 = Xima\XimaTypo3Manual\DataProcessing\ManualSettingsProcessor

      # Manual logo from root page media field
      40 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
      40 {
        references.table = pages
        references.uid.data = levelUid:0
        references.fieldName = media
        as = manualLogo
        maxItems = 1
      }

      # "On this page" is only worth showing from two headings on: content headings of the page, the steps of an msteps
      # element included
      50 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
      50 {
        table = tt_content
        pidInList.data = page:uid
        where = header!="" and CType!="mbox" and (colPos=0 or tx_ximatypo3manual_parent>0)
        max = 2
        as = currentHeadings
      }

      # Language menu
      30 = TYPO3\CMS\Frontend\DataProcessing\LanguageMenuProcessor
      30 {
        languages = auto
        as = languageNavigation
      }
    }
  }

  includeCSS {
    fonts = EXT:xima_typo3_manual/Resources/Public/Css/Frontend/fonts.css
    manual = EXT:xima_typo3_manual/Resources/Public/Css/Frontend/manual.css
    focuspoint = EXT:xima_typo3_manual/Resources/Public/Css/Frontend/focuspoint.css
  }

  includeJS {
    colorScheme = EXT:xima_typo3_manual/Resources/Public/JavaScript/ColorScheme.js
  }

  includeJSFooter {
    navigation = EXT:xima_typo3_manual/Resources/Public/JavaScript/Navigation.js
    navigation.type = module
    glossary = EXT:xima_typo3_manual/Resources/Public/JavaScript/Glossary.js
    glossary.type = module
    tree = EXT:xima_typo3_manual/Resources/Public/JavaScript/Tree.js
    tree.type = module
    toc = EXT:xima_typo3_manual/Resources/Public/JavaScript/Toc.js
    toc.type = module
  }
}

[(request.getQueryParams()['colorScheme'] ?? '') == 'dark']
  config.htmlTag.attributes.data-theme = dark
[END]

[(request.getQueryParams()['colorScheme'] ?? '') == 'light']
  config.htmlTag.attributes.data-theme = light
[END]

config.index_enable = 1
config.index_externals = 0

[(request.getQueryParams()['context'] ?? '') == 'backend']
  config.index_enable = 0
[END]

plugin.tx_indexedsearch {
  settings {
    displayAdvancedSearchLink = 0
    displayResultNumber = 0
  }
  view {
    templateRootPaths.20 = EXT:xima_typo3_manual/Resources/Private/Extensions/IndexedSearch/Templates/
    partialRootPaths.20 = EXT:xima_typo3_manual/Resources/Private/Extensions/IndexedSearch/Partials/
  }
}

plugin.tx_indexedsearch_pi2_form = EXTBASEPLUGIN
plugin.tx_indexedsearch_pi2_form {
  extensionName = IndexedSearch
  pluginName = Pi2
  action = form
}

plugin.tx_indexedsearch_pi2_results = EXTBASEPLUGIN
plugin.tx_indexedsearch_pi2_results {
  extensionName = IndexedSearch
  pluginName = ManualResults
  action = search
}

pdf < page
pdf.typeNum = 1664618986
pdf.10.variables.type.value = pdf
pdf.10.variables.context.value = pdf
pdf.config.index_enable = 0
pdf.includeJS.colorScheme >
pdf.includeJSFooter.navigation >
pdf.includeJSFooter.glossary >
pdf.includeJSFooter.tree >
pdf.includeJSFooter.toc >
pdf.includeCSS {
  fonts >
  manual.inline = 1
  focuspoint.inline = 1
}

tt_content {

  mtext =< tt_content.textmedia
  mtext.templateName = Mtext

  mbox =< tt_content.textmedia
  mbox.templateName = Mbox

  msteps =< tt_content.textmedia
  msteps.templateName = Msteps
  msteps {
    dataProcessing {
      30 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
      30 {
        as = slides
        table = tt_content
        pidInList.field = pid
        where = {#tx_ximatypo3manual_parent}=###uid###
        markers.uid.field = uid
        orderBy = sorting
      }
    }
  }

  mglossary =< tt_content.textmedia
  mglossary.templateName = Mglossary
  mglossary {
    dataProcessing {
      30 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
      30 {
        as = terms
        table = tt_content
        pidInList.field = pid
        where = {#tx_ximatypo3manual_parent}=###uid###
        markers.uid.field = uid
        orderBy = sorting
      }
    }
  }

  mterm =< tt_content.textmedia
  mterm.templateName = Mterm

  mannotation =< tt_content.textmedia
  mannotation.templateName = Mannotation
  mannotation {
    dataProcessing {
      30 = Xima\XimaTypo3Manual\DataProcessing\FocuspointProcessor
      30 {
        references.fieldName = assets
        as = images
      }
    }

    variables {
      color = TEXT
      color.value = {$manual.appearance.primaryColor}

      context = TEXT
      context.value = frontend
      context.override.data = GP:context
    }
  }
}

# Provides every content element template with a Record object, which f:render.text needs
lib.contentElement.dataProcessing.1768551979 = record-transformation

lib.contentElement.variables.context = TEXT
lib.contentElement.variables.context.value = frontend
lib.contentElement.variables.context.override.data = GP:context

lib.contentElement.variables.veEditMode = TEXT
lib.contentElement.variables.veEditMode.data = GP:editMode

lib.contentElement.partialRootPaths.100 = EXT:xima_typo3_manual/Resources/Private/Partials/

lib.contentElement.variables.headingLevel = TEXT
lib.contentElement.variables.headingLevel {
  data = register:headingLevel
  ifEmpty = 3
}

lib.dynamicContent = COA
lib.dynamicContent {
  10 = LOAD_REGISTER
  10.colPos.cObject = TEXT
  10.colPos.cObject {
    field = colPos
    ifEmpty.cObject = TEXT
    ifEmpty.cObject {
      value.current = 1
      ifEmpty = 0
    }
  }
  10.headingLevel.cObject = TEXT
  10.headingLevel.cObject {
    field = headingLevel
    ifEmpty = 3
  }

  20 = CONTENT
  20 {
    table = tt_content
    select {
      orderBy = sorting
      pidInList.field = pid
      where = {#colPos}={register:colPos}
      where.insertData = 1
    }
  }

  90 = RESTORE_REGISTER
}

lib.singleContent = COA
lib.singleContent {
  20 = CONTENT
  20 {
    table = tt_content
    select {
      pidInList = {field:pid}
      pidInList.insertData = 1
      where = {#uid}={field:uid}
      where.insertData = 1
    }
  }
}

page.footerData.1637328467 >

[request && request.getPageArguments()?.getPageType() == 1664618986]
  lib.contentElement.variables.context.value = pdf
  tt_content.mannotation.variables.context.value = pdf
[END]
